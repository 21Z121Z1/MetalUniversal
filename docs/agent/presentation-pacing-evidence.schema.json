{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metallum.invalid/schemas/presentation-pacing-evidence.schema.json",
  "title": "MetalUniversal presentation pacing evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frameIndex",
    "refreshRateHz",
    "targetPresentIntervalNanos",
    "targetPresentIntervalNanosAvailable",
    "targetPresentIntervalNanosMeasured",
    "targetPresentIntervalNanosUnit",
    "targetPresentIntervalNanosProvenance",
    "targetPresentIntervalNanosFallbackReason",
    "measuredPresentIntervalNanos",
    "measuredPresentIntervalNanosAvailable",
    "measuredPresentIntervalNanosMeasured",
    "measuredPresentIntervalNanosUnit",
    "measuredPresentIntervalNanosProvenance",
    "measuredPresentIntervalNanosFallbackReason",
    "cpuFrameTimeNanos",
    "cpuFrameTimeNanosAvailable",
    "cpuFrameTimeNanosMeasured",
    "cpuFrameTimeNanosUnit",
    "cpuFrameTimeNanosProvenance",
    "cpuFrameTimeNanosFallbackReason",
    "gpuFrameTimeNanos",
    "gpuFrameTimeNanosAvailable",
    "gpuFrameTimeNanosMeasured",
    "gpuFrameTimeNanosUnit",
    "gpuFrameTimeNanosProvenance",
    "gpuFrameTimeNanosFallbackReason",
    "drawableWaitNanos",
    "drawableWaitNanosAvailable",
    "drawableWaitNanosMeasured",
    "drawableWaitNanosUnit",
    "drawableWaitNanosProvenance",
    "drawableWaitNanosFallbackReason",
    "framesInFlight",
    "framesInFlightAvailable",
    "framesInFlightMeasured",
    "framesInFlightUnit",
    "framesInFlightProvenance",
    "framesInFlightFallbackReason",
    "provenance",
    "fallbackReason"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "frameIndex": {"type": "integer", "minimum": 0},
    "refreshRateHz": {"type": ["integer", "null"], "minimum": 1},
    "targetPresentIntervalNanos": {"$ref": "#/$defs/nanos"},
    "targetPresentIntervalNanosAvailable": {"$ref": "#/$defs/available"},
    "targetPresentIntervalNanosMeasured": {"$ref": "#/$defs/measured"},
    "targetPresentIntervalNanosUnit": {"$ref": "#/$defs/nanosUnit"},
    "targetPresentIntervalNanosProvenance": {"$ref": "#/$defs/metricProvenance"},
    "targetPresentIntervalNanosFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "measuredPresentIntervalNanos": {"$ref": "#/$defs/nanos"},
    "measuredPresentIntervalNanosAvailable": {"$ref": "#/$defs/available"},
    "measuredPresentIntervalNanosMeasured": {"$ref": "#/$defs/measured"},
    "measuredPresentIntervalNanosUnit": {"$ref": "#/$defs/nanosUnit"},
    "measuredPresentIntervalNanosProvenance": {"$ref": "#/$defs/metricProvenance"},
    "measuredPresentIntervalNanosFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "cpuFrameTimeNanos": {"$ref": "#/$defs/nanos"},
    "cpuFrameTimeNanosAvailable": {"$ref": "#/$defs/available"},
    "cpuFrameTimeNanosMeasured": {"$ref": "#/$defs/measured"},
    "cpuFrameTimeNanosUnit": {"$ref": "#/$defs/nanosUnit"},
    "cpuFrameTimeNanosProvenance": {"$ref": "#/$defs/metricProvenance"},
    "cpuFrameTimeNanosFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "gpuFrameTimeNanos": {"$ref": "#/$defs/nanos"},
    "gpuFrameTimeNanosAvailable": {"$ref": "#/$defs/available"},
    "gpuFrameTimeNanosMeasured": {"$ref": "#/$defs/measured"},
    "gpuFrameTimeNanosUnit": {"$ref": "#/$defs/nanosUnit"},
    "gpuFrameTimeNanosProvenance": {"$ref": "#/$defs/metricProvenance"},
    "gpuFrameTimeNanosFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "drawableWaitNanos": {"$ref": "#/$defs/nanos"},
    "drawableWaitNanosAvailable": {"$ref": "#/$defs/available"},
    "drawableWaitNanosMeasured": {"$ref": "#/$defs/measured"},
    "drawableWaitNanosUnit": {"$ref": "#/$defs/nanosUnit"},
    "drawableWaitNanosProvenance": {"$ref": "#/$defs/metricProvenance"},
    "drawableWaitNanosFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "framesInFlight": {"$ref": "#/$defs/count"},
    "framesInFlightAvailable": {"$ref": "#/$defs/available"},
    "framesInFlightMeasured": {"$ref": "#/$defs/measured"},
    "framesInFlightUnit": {"$ref": "#/$defs/countUnit"},
    "framesInFlightProvenance": {"$ref": "#/$defs/metricProvenance"},
    "framesInFlightFallbackReason": {"$ref": "#/$defs/metricFallback"},
    "provenance": {"type": "string", "minLength": 1},
    "fallbackReason": {"type": ["string", "null"]}
  },
  "$defs": {
    "nanos": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "count": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "available": {"type": "boolean"},
    "measured": {"type": "boolean"},
    "unit": {"type": "string", "enum": ["nanoseconds", "count"]},
    "nanosUnit": {"type": "string", "const": "nanoseconds"},
    "countUnit": {"type": "string", "const": "count"},
    "metricProvenance": {"type": "string", "minLength": 1},
    "metricFallback": {"type": ["string", "null"]}
  }
}
