    "native_cross_check": "metallum_metal4_main_renderer_stats",
    "command_allocator_resets": "derived one-for-one from successful Metal4 acquire; the native static gate independently proves exactly one allocator.reset after free-slot acquisition",
    "slot_wait_nanos": "conservative upper bound: wall time of native command-buffer acquisition only when all three Java-side submissions are still unretired",
    "slot_wait_safety": "the conservative upper bound may reject noise but cannot hide a real slot-wait regression",
    "per_frame_rates": "computed from cumulative counter deltas divided by presentation encode delta over the same measurement window",
    "hot_path_stats_ffm_queries_per_frame": 0,
