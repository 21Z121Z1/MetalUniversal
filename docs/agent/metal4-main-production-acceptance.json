    "failed_command_buffers": 0,
    "failed_present_command_buffers": 0,
    "nil_drawables": 0,
    "framebuffer_equivalence_required": true,
    "resource_reload_recovery_required": true
  },
  "required_runtime_metrics": [
    "metal4.commandAllocatorResets",
    "metal4.slotWaitNanos",
    "metal4.slotWaitCount",
    "metal4.commandBuffersPerFrame",
    "metal4.commitCallsPerFrame",
    "metal4.argumentTableAllocationsDuringEncoding",
    "metal4.computeTableOverflow",
    "metal4.renderTableHighWater"
