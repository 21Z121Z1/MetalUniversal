        {"kind": "test", "id": "IrisMetalPingPongTargetsIntegrationTest"}
      ]
    },
    {
      "id": "lifecycle.generation-ownership",
      "status": "verified",
      "contract": "Closed generations cannot answer draw/resource lookups after retirement.",
      "evidence": [
        {"kind": "source", "id": "MetalWorldRenderingPipeline#destroy"},
        {"kind": "test", "id": "IrisMetalRuntimeReceiptsTest"}
      ]
    },
    {
      "id": "failure.unsupported-resource",
      "status": "verified",
      "contract": "Missing or unsupported sampler/image/buffer contracts throw instead of substituting placeholders or disabling shaders.",
      "evidence": [
        {"kind": "source", "id": "IrisMetalExecutionGraph#textureBinding"},
        {"kind": "source", "id": "IrisMetalPackLifecycle#strictModeRequested"}
      ]
    },
    {
      "id": "runtime.pass-order-and-contribution",
      "status": "runtime",
      "contract": "A physical run records setup, begin, either a complete shadow scene or an explicit empty shadow route, depthtex, deferred, composite, final and color-space finalization in Iris order with final readback.",
      "shadowMode": "scene-or-empty",
      "shadowEvidence": "scene-content-or-empty",
      "shadowStageEvidence": "required-when-scene",
      "receiptEvents": [
        "setup", "begin", "shadow.render.begin", "shadow.composite", "depthtex1.capture",
        "deferred", "depthtex2.capture", "composite", "final", "color-space.finalized"
      ]
    },
    {
      "id": "runtime.reload-disable-enable",
      "status": "runtime",
      "contract": "A physical run retires a generation, reloads it, disables and re-enables shaders, and never binds a retired generation.",
      "controlEvents": [
        "reload.begin", "reload.end", "disable-enable.disable.begin",
        "disable-enable.disable.end", "disable-enable.enable.begin", "disable-enable.enable.end"
      ],
      "receiptEvents": ["generation-retired"]
    },
    {
      "id": "runtime.readback-dynamic-exit",
      "status": "runtime",
      "contract": "A physical Quick Play run enters a world, has non-black final frames, changed pixels across sustained frames, and a normal client exit.",
      "controlEvents": ["world.entered"],
      "receiptMetrics": ["nonBlackRgbPixels", "changedPixels", "meanAbsoluteByteDelta"],
      "requiresExitStatus": 0
    }
  ]
